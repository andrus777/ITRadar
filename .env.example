IT_RADAR_APP_NAME=IT Radar
IT_RADAR_ENVIRONMENT=development
IT_RADAR_DATABASE_URL=postgresql+asyncpg://it_radar:it_radar@localhost:5432/it_radar
IT_RADAR_B2B_CENTER_ENABLED=true
IT_RADAR_B2B_CENTER_TIMEOUT_SECONDS=30
IT_RADAR_FL_RU_ENABLED=true
IT_RADAR_FL_RU_TIMEOUT_SECONDS=30
IT_RADAR_FL_RU_CATEGORIES=программирование,python,интеграция по api,разработка чат-ботов,машинное обучение,парсинг данных,1с-программирование,разработка crm и erp,devops,fullstack,веб-программирование,mobile,создание mvp,n8n,ai — искусственный интеллект,автоматизация бизнеса
IT_RADAR_JOBICY_ENABLED=true
IT_RADAR_JOBICY_TIMEOUT_SECONDS=30
IT_RADAR_REMOTEOK_ENABLED=true
IT_RADAR_REMOTEOK_TIMEOUT_SECONDS=30
IT_RADAR_WEWORKREMOTELY_ENABLED=true
IT_RADAR_WEWORKREMOTELY_TIMEOUT_SECONDS=30
IT_RADAR_WORKSPACE_ENABLED=true
IT_RADAR_WORKSPACE_TIMEOUT_SECONDS=30
IT_RADAR_FREELANCE_RU_ENABLED=true
IT_RADAR_FREELANCE_RU_TIMEOUT_SECONDS=30
IT_RADAR_FREELANCE_RU_CATEGORIES=Веб-разработка и IT,Искусственный интеллект
IT_RADAR_AI_API_KEY=
IT_RADAR_AI_BASE_URL=https://api.openai.com/v1
IT_RADAR_AI_MODEL=gpt-5-mini
IT_RADAR_AI_PROMPT_VERSION=v1
IT_RADAR_AI_TIMEOUT_SECONDS=60
IT_RADAR_TELEGRAM_BOT_TOKEN=
IT_RADAR_TELEGRAM_DEFAULT_PROFILE_ID=
IT_RADAR_TELEGRAM_DIGEST_CHAT_ID=
IT_RADAR_DIGEST_MIN_SCORE=70
IT_RADAR_DIGEST_BATCH_SIZE=20
IT_RADAR_INCLUDE_INTERNATIONAL=false
IT_RADAR_SCHEDULER_ENABLED=true
IT_RADAR_SCHEDULER_CRON=0 9 * * *
IT_RADAR_SCHEDULER_TIMEZONE=Europe/Moscow
IT_RADAR_HTTP_RETRY_ATTEMPTS=3
IT_RADAR_HTTP_RETRY_BACKOFF_SECONDS=0.5
IT_RADAR_LOG_LEVEL=INFO

# Docker Compose PostgreSQL settings
POSTGRES_DB=it_radar
POSTGRES_USER=it_radar
POSTGRES_PASSWORD=it_radar
APP_PORT=8000
DB_PORT=5432
