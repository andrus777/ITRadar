IT_RADAR_APP_NAME=IT Radar
IT_RADAR_ENVIRONMENT=development
IT_RADAR_DATABASE_URL=postgresql+asyncpg://it_radar:it_radar@localhost:5432/it_radar
IT_RADAR_JOBICY_ENABLED=true
IT_RADAR_JOBICY_TIMEOUT_SECONDS=30
IT_RADAR_REMOTEOK_ENABLED=true
IT_RADAR_REMOTEOK_TIMEOUT_SECONDS=30
IT_RADAR_WEWORKREMOTELY_ENABLED=true
IT_RADAR_WEWORKREMOTELY_TIMEOUT_SECONDS=30

# Docker Compose PostgreSQL settings
POSTGRES_DB=it_radar
POSTGRES_USER=it_radar
POSTGRES_PASSWORD=it_radar
APP_PORT=8000
DB_PORT=5432
